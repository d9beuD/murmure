    "onboarding.transcription.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a ready transcription provider. You can add and edit remote providers later in Settings." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez un fournisseur de transcription prêt à l’emploi. Vous pourrez ajouter et modifier les fournisseurs distants plus tard dans les Réglages." } } } },
    "onboarding.transcription.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Transcription connection" } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Connexion de transcription" } } } },
    "onboarding.welcome.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Entrevoix records your voice locally, then sends the short audio file to your chosen STT provider. A second provider can then clean up the text if you enable that option." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Entrevoix enregistre votre voix localement, puis envoie le court fichier audio au fournisseur STT de votre choix. Un second fournisseur peut ensuite nettoyer le texte si vous activez cette option." } } } },
    "onboarding.welcome.privacy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "API keys stay in the macOS Keychain. Temporary audio files are deleted after dictation. Entrevoix has no servers or user accounts of its own." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Les clés API restent dans le trousseau macOS. Les fichiers audio temporaires sont supprimés après chaque dictée. Entrevoix n’a ni serveur ni compte utilisateur propre." } } } },
    "onboarding.welcome.settings_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You can change all of these choices later in Settings." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Vous pourrez modifier tous ces choix plus tard dans les Réglages." } } } },
    "onboarding.welcome.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to Entrevoix" } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Bienvenue dans Entrevoix" } } } },
