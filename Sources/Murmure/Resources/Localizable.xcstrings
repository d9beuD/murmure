    "permission.accessibility_insertion_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility permission is only required for automatic insertion. Without it, Murmure uses the clipboard." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "L’autorisation d’accessibilité est uniquement requise pour l’insertion automatique. Sans elle, Murmure utilise le presse-papiers." } } } },
