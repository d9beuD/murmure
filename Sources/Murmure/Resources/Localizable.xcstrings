    "onboarding.connection.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This test is optional: speak a short phrase, then Murmure will send it to your STT provider. The test transcription is not retained." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Ce test est facultatif : prononcez une courte phrase, puis Murmure l’enverra à votre fournisseur STT. La transcription de test n’est pas conservée." } } } },
    "onboarding.connection.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Test the connection" } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Tester la connexion" } } } },
    "onboarding.delivery.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delivery and preferences" } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Distribution et préférences" } } } },
    "onboarding.shortcut.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose the shortcut that will trigger Murmure, even when another app is in the foreground." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez le raccourci qui déclenchera Murmure, même lorsqu’une autre app est au premier plan." } } } },
