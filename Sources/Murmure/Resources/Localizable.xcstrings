    "onboarding.transcription.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter the OpenAI-compatible endpoint and STT model to use." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Saisissez l’endpoint compatible OpenAI et le modèle STT à utiliser." } } } },
    "onboarding.transcription.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Transcription connection" } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Connexion de transcription" } } } },
    "onboarding.welcome.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Murmure records your voice locally, then sends the short audio file to your chosen STT provider. A second provider can then clean up the text if you enable that option." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Murmure enregistre votre voix localement, puis envoie le court fichier audio au fournisseur STT de votre choix. Un second fournisseur peut ensuite nettoyer le texte si vous activez cette option." } } } },
    "onboarding.welcome.privacy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "API keys stay in the macOS Keychain. Temporary audio files are deleted after dictation. Murmure has no servers or user accounts of its own." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Les clés API restent dans le trousseau macOS. Les fichiers audio temporaires sont supprimés après chaque dictée. Murmure n’a ni serveur ni compte utilisateur propre." } } } },
    "onboarding.welcome.settings_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You can change all of these choices later in Settings." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Vous pourrez modifier tous ces choix plus tard dans les Réglages." } } } },
    "onboarding.welcome.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to Murmure" } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Bienvenue dans Murmure" } } } },
